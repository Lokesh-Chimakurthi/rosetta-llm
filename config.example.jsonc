{
  // =============================================================================
  // Rosetta — Configuration
  // =============================================================================
  // Copy this file to ~/.rosetta-llm/config.json and remove comments.
  // The proxy reads ~/.rosetta-llm/config.json by default.
  // Override with --config flag or ROSETTA_CONFIG env var.
  // =============================================================================

  // Optional: bind address. Defaults to 127.0.0.1:7860.
  // A non-loopback host (e.g. "0.0.0.0") requires proxy.api_keys or
  // proxy.allow_unauthenticated, otherwise startup is refused.
  "host": "127.0.0.1",
  "port": 7860,

  // Optional: API-key auth on the proxy itself. Clients send
  // "Authorization: Bearer <key>" or "x-api-key: <key>".
  // If omitted or empty, all incoming requests are accepted.
  "proxy": {
    "api_keys": ["sk-proxy-XXXX"],
    // Serve without keys on a non-loopback host (another layer authenticates).
    "allow_unauthenticated": false,
    // Honour X-Forwarded-* only from these comma-separated IPs.
    "trust_proxy_headers": false,
    "forwarded_allow_ips": "127.0.0.1"
  },

  // Logging: "debug" | "info" | "warning" | "error" (default "info").
  // info logs request_started per request; debug adds upstream_request/_response.
  // Each has a --flag / --no-flag override. See README "Logging".
  "log_level": "info",
  // Also log request_completed (status, latency, tokens) for every request.
  "log_completed": false,
  // Debug only: add headers (credentials redacted) / bodies (first 64 KiB).
  "log_headers": false,
  "log_bodies": false,

  // Optional: fallback provider for callers that send bare model names
  // without the `<provider>/` prefix (e.g. OpenAI Codex CLI strips
  // `anthropic/` before forwarding). Must match a key under `providers`.
  // Omit for strict mode where every request must carry an explicit prefix.
  // "default_provider": "abc",

  // Optional: answer Claude Code's auto mode review for providers that cannot.
  // Without it, Claude Code in auto mode denies tool calls on translated models.
  // Uncomment to enable; see README "Auto mode classifier".
  //   classifier_model (required): the reviewing model, <provider_key>/<model_name>.
  //   timeout_seconds: wait for a verdict, then deny the call (default 30).
  //   max_output_tokens: cap on the classifier's reply (default 4096).
  //   builtin_rules: "claude_cli" (default) loads Claude Code's built-in rules at
  //     startup by running `<claude_cli> auto-mode defaults`, and startup fails if
  //     it can't; "none" uses only the user's rules and the instructions file.
  //   instructions_file: optional Markdown appended to the classifier's prompt.
  // "auto_mode": {
  //   "classifier_model": "abc/kimi-k2.5",
  //   "timeout_seconds": 30,
  //   "max_output_tokens": 4096,
  //   "builtin_rules": "claude_cli",
  //   "claude_cli": "claude",
  //   "instructions_file": "~/.rosetta-llm/auto-mode.md"
  // },

  // =============================================================================
  // Provider definitions. Keys are the prefix used in model ids.
  // Model id format: <provider_key>/<model_name>
  // =============================================================================
  "providers": {
    // ---------------------------------------------------------------------------
    // Example: OpenAI Chat-format provider (e.g., DeepSeek, Groq, OpenRouter)
    // ---------------------------------------------------------------------------
    "abc": {
      // The native API format this provider speaks.
      // One of: "openai_chat" | "openai_responses" | "anthropic"
      "format": "openai_chat",

      // Upstream base URL. The proxy appends the format's standard path:
      //   openai_chat:     <base_url>/chat/completions
      //   openai_responses: <base_url>/responses
      //   anthropic:       <base_url>/messages
      "base_url": "https://api.abc.com/v1",

      // API key. Choose ONE:
      "api_key": "sk-...",
      // "api_key_env": "ABC_API_KEY",

      // Optional headers merged into every upstream request.
      "extra_headers": {
        "X-Custom": "value"
      },

      // Optional headers whose values are secrets — resolved from env vars
      // at startup. Each entry maps header name -> env var name.
      // The env var MUST be set and non-empty, or startup fails.
      // A header name must NOT appear in both extra_headers and extra_headers_env.
      "extra_headers_env": {
        "X-Secret-Header": "ABC_SECRET_HEADER"
      },

      // Connection timeouts (seconds). Defaults to 30 connect / 600 read.
      "timeout": { "connect": 30, "read": 600 },

      // Models. Either an explicit list OR ["*"] to auto-discover via upstream /v1/models.
      // Auto-discover caches results for models_ttl_seconds (default 300).
      "models": [
        {
          "id": "kimi-k2.5",
          // Optional: remap model name sent upstream (default = id)
          "upstream_name": "moonshotai/kimi-k2.5",
          // Optional capabilities. Permissive default if omitted.
          "supports": {
            "tools": true,
            "vision": false,
            "thinking": true,
            "structured_output": true
          },
          // Optional default reasoning budget when target uses budget instead of effort
          "thinking_budget_default": 12288
        }
      ],
      "models_ttl_seconds": 300
    },

    // ---------------------------------------------------------------------------
    // Example: Anthropic provider
    // ---------------------------------------------------------------------------
    "anthropic": {
      "format": "anthropic",
      "base_url": "https://api.anthropic.com/v1",
      "api_key_env": "ANTHROPIC_API_KEY",
      "extra_headers": {
        "anthropic-version": "2023-06-01"
      },
      // Who reviews auto mode tool calls: "upstream" (default; the provider,
      // as the Anthropic API does) or "rosetta" (auto_mode.classifier_model,
      // for Anthropic-format providers that return no verdicts).
      "auto_mode_review": "upstream",
      // Auto-discover all models from upstream
      "models": ["*"]
    },

    // ---------------------------------------------------------------------------
    // Example: OpenAI Responses-format provider
    // ---------------------------------------------------------------------------
    "openai": {
      "format": "openai_responses",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "models": [
        { "id": "gpt-5.4" },
        { "id": "gpt-5.5" }
      ]
    }
  }
}
